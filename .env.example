# Copy values into your deployment's secret manager or a private environment file.
# Do not commit real secrets. Google sign-in is the production default.
MCK_SECRET_KEY=
MCK_AUTH_MODE=google
MCK_HTTPS=1
MCK_DATA_DIR=/data
MCK_GOOGLE_CLIENT_ID=
MCK_GOOGLE_CLIENT_SECRET=
MCK_GOOGLE_REDIRECT_URI=https://YOUR-HOST/auth/google/callback

# Supabase Postgres: use a dedicated backend login, not a publishable/API key.
# Leave unset for local SQLite development. Never commit a real connection string.
MCK_DATABASE_URL=
MCK_DB_SSLMODE=verify-full
MCK_DB_SSLROOTCERT=system
# Set to 1 in hosted deployments to prevent accidental SQLite fallback.
MCK_REQUIRE_POSTGRES=0
